{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"types": ["$app/types", "node", "youtube"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
